{
  "name": "meine-ai",
  "version": "1.0.0",
  "description": "Lokaler KI-Programmierassistent mit Ollama",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis zip" },
  "devDependencies": { "electron": "^40.0.0", "electron-builder": "^26.0.12" },
  "build": {
    "appId": "de.meineai.desktop",
    "productName": "Meine AI",
    "files": ["main.js", "preload.js", "index.html", "style.css", "renderer.js", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "zip"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}